{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug-config",
      "displayName": "debug configure preset",
      "binaryDir": "${sourceDir}/build/debug",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "relinfo-config",
      "displayName": "release with debug info configure preset",
      "binaryDir": "${sourceDir}/build/relinfo",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PICAN_CONTRACTS_DISABLED": ""
      }
    },
    {
      "name": "debug-aarch64-config",
      "inherits": "debug-config",
      "binaryDir": "${sourceDir}/build/debug-aarch64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/aarch64-toolchain.cmake",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-aarch64;-L;/usr/aarch64-linux-gnu"
      }
    },
    {
      "name": "relinfo-aarch64-config",
      "inherits": "relinfo-config",
      "binaryDir": "${sourceDir}/build/relinfo-aarch64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/aarch64-toolchain.cmake",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-aarch64;-L;/usr/aarch64-linux-gnu"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-app",
      "displayName": "debug app (no tests)",
      "targets": [
        "pican-app"
      ],
      "configurePreset": "debug-config"
    },
    {
      "name": "debug-test",
      "displayName": "debug tests",
      "targets": [
        "pican-test"
      ],
      "configurePreset": "debug-config"
    },
    {
      "name": "relinfo-app",
      "displayName": "relinfo app (no tests)",
      "targets": [
        "pican-app"
      ],
      "configurePreset": "relinfo-config"
    },
    {
      "name": "relinfo-test",
      "displayName": "relinfo tests",
      "targets": [
        "pican-test"
      ],
      "configurePreset": "relinfo-config"
    },
    {
      "name": "debug-aarch64-test",
      "displayName": "debug aarch64 tests",
      "targets": [
        "pican-test"
      ],
      "configurePreset": "debug-aarch64-config"
    },
    {
      "name": "relinfo-aarch64-test",
      "displayName": "relinfo aarch64 tests",
      "targets": [
        "pican-test"
      ],
      "configurePreset": "relinfo-aarch64-config"
    }
  ],
  "testPresets": [
    {
      "name": "debug-run-tests",
      "configurePreset": "debug-config",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "relinfo-run-tests",
      "configurePreset": "relinfo-config",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-aarch64-run-tests",
      "configurePreset": "debug-aarch64-config",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "relinfo-aarch64-run-tests",
      "configurePreset": "relinfo-aarch64-config",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug-test",
      "description": "runs configure, build, and tests for debug",
      "steps": [
        {
          "type": "configure",
          "name": "debug-config"
        },
        {
          "type": "build",
          "name": "debug-test"
        },
        {
          "type": "test",
          "name": "debug-run-tests"
        }
      ]
    },
    {
      "name": "relinfo-test",
      "displayName": "release with debug info",
      "description": "runs configure, build, and tests for relinfo",
      "steps": [
        {
          "type": "configure",
          "name": "relinfo-config"
        },
        {
          "type": "build",
          "name": "relinfo-test"
        },
        {
          "type": "test",
          "name": "relinfo-run-tests"
        }
      ]
    },
    {
      "name": "debug-aarch64-test",
      "description": "runs configure, build, and tests for debug aarch64",
      "steps": [
        {
          "type": "configure",
          "name": "debug-aarch64-config"
        },
        {
          "type": "build",
          "name": "debug-aarch64-test"
        },
        {
          "type": "test",
          "name": "debug-aarch64-run-tests"
        }
      ]
    },
    {
      "name": "relinfo-aarch64-test",
      "displayName": "release with debug info",
      "description": "runs configure, build, and tests for relinfo aarch64",
      "steps": [
        {
          "type": "configure",
          "name": "relinfo-aarch64-config"
        },
        {
          "type": "build",
          "name": "relinfo-aarch64-test"
        },
        {
          "type": "test",
          "name": "relinfo-aarch64-run-tests"
        }
      ]
    }
  ]
}